# -----------------------------------------------------------------------------
# n8n-hubspot-contact-role-decay-reverification-cron
# Copy to .env (git-ignored) for the Node.js CLI, or set the same variables on
# the n8n host. Every credential below is an uppercase dummy placeholder.
# Out of the box nothing leaves the machine and nothing is written:
#   DRY_RUN=true, SANDBOX_MODE=true, SMTP_CHECKER_PROVIDER=mock, LOG_TARGET=none
# -----------------------------------------------------------------------------

# --- Safety switches (anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true

# --- Audit window
# Rolling cadence: a run only proceeds when this many days have passed since the last completed live audit
AUDIT_INTERVAL_DAYS=90
# Contacts count as aging when last modified and last sales activity are older than this
STALE_AFTER_DAYS=180
# Skip contacts this workflow already checked within this many days
RECHECK_AFTER_DAYS=90
MAX_CONTACTS_PER_RUN=2000
ONLY_MARKETING_CONTACTS=true

# --- HubSpot (Private App). A placeholder token keeps the client offline.
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN_HERE
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID_HERE
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_SEARCH_DELAY_MS=300

# --- Email deliverability check
# mock (offline, reserved test domains only) | zerobounce | neverbounce | custom
SMTP_CHECKER_PROVIDER=mock
SMTP_CHECKER_API_KEY=YOUR_SMTP_CHECKER_API_KEY_HERE
# custom provider only: HTTPS endpoint accepting POST {"email"} and returning {"status": "valid|invalid|..."}
SMTP_CHECKER_URL=YOUR_SMTP_CHECKER_URL_HERE
SMTP_CHECK_DELAY_MS=250
SMTP_CHECK_TIMEOUT_MS=10000
MAX_VERIFICATIONS_PER_RUN=500

# --- Buyer title criteria (comma-separated, case-insensitive, whole-word match)
TARGET_TITLE_KEYWORDS=chief,ceo,cfo,cro,cmo,coo,cto,founder,owner,president,vp,vice president,head of,director,manager,revops,revenue operations,marketing operations,sales operations
EXCLUDED_TITLE_KEYWORDS=student,intern,retired,former,unemployed,seeking,test
# flag | quarantine
TITLE_MISMATCH_ACTION=flag
# flag | ignore
MISSING_TITLE_ACTION=flag

# --- Update policy
# catch-all / unknown results: quarantine | flag
UNVERIFIED_ACTION=quarantine
# role addresses (info@, sales@ ...): flag | quarantine
ROLE_ADDRESS_ACTION=flag
# Statuses that should become non-marketing contacts
NON_MARKETING_STATUSES=quarantine_bounced,quarantine_invalid,quarantine_disposable,quarantine_risky
# quarantine_only (recommended: a HubSpot workflow flips marketing status) | property (also writes hs_marketable_status=false)
MARKETING_STATUS_WRITE_MODE=quarantine_only
EXEMPT_LIFECYCLE_STAGES=customer,evangelist,opportunity
# Circuit breaker: abort all writes if more than this share of checked contacts would be quarantined
MAX_QUARANTINE_RATIO=0.3
CIRCUIT_BREAKER_MIN_SAMPLE=20
MAX_UPDATES_PER_RUN=1000

# --- Savings estimate (your contract's marketing-contact price per 1,000 contacts per month)
MARKETING_CONTACT_MONTHLY_COST_PER_1000=0
COST_CURRENCY=USD

# --- Summary log
# none | webhook | google_sheets
LOG_TARGET=none
LOG_WEBHOOK_URL=YOUR_LOG_WEBHOOK_URL_HERE
LOG_WEBHOOK_SECRET=YOUR_LOG_WEBHOOK_SECRET_HERE
LOG_INCLUDE_CONTACT_IDS=false
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_GOOGLE_SERVICE_ACCOUNT_JSON_HERE
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_GOOGLE_SHEETS_SPREADSHEET_ID_HERE
GOOGLE_SHEETS_RANGE=Hygiene Log!A1

# --- Offline simulation only
SIMULATE_TODAY=2026-11-16
